PORT=5001
# Needed for accounts and saved reading. Receipt generation alone works without it.
MONGO_URI=mongodb://127.0.0.1:27017/cursive
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Signs the sign-in cookie. Use a long random string, e.g. `openssl rand -hex 48`.
JWT_SECRET=
