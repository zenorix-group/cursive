PORT=5001
# Needed for accounts and saved reading. Receipt generation alone works without it.
MONGO_URI=mongodb://127.0.0.1:27017/cursive
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Signs the sign-in cookie. Use a long random string, e.g. `openssl rand -hex 48`.
JWT_SECRET=

# Needed to email the combined receipt (a PDF) when a reader finishes both articles.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cursive <you@example.com>"

# Optional: send receipts through Vercel AI Gateway instead of calling Gemini directly.
# Set AI_PROVIDER=gateway on Vercel (uses the deployment's OIDC token), or set AI_GATEWAY_API_KEY anywhere.
# The Vercel team needs a credit card on file before the gateway serves requests.
AI_PROVIDER=
AI_GATEWAY_API_KEY=
# Defaults to google/<GEMINI_MODEL>.
AI_GATEWAY_MODEL=
